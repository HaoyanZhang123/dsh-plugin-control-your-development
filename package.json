{
  "name": "dsh-plugin-control-your-development",
  "version": "0.5.0",
  "description": "开发仪表盘 —— 把 control-your-development 的产品仪表盘嵌进 DSH 右侧边栏与会话页",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./assets/icon.webp",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "locale",
    "assets/icon.webp",
    "PLUGIN.md",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "skill"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.2.0-0 <0.2.1-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-0 <0.2.1-0",
    "@deepseek-ai/dsh-settings": ">=0.2.0-0 <0.2.1-0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaoyanZhang123/dsh-plugin-control-your-development.git"
  },
  "homepage": "https://github.com/HaoyanZhang123/dsh-plugin-control-your-development#readme",
  "bugs": {
    "url": "https://github.com/HaoyanZhang123/dsh-plugin-control-your-development/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dev-dashboard",
    "dashboard",
    "control-your-development",
    "deepseek-harness",
    "product-dashboard"
  ],
  "publishConfig": {
    "access": "public"
  }
}
